class Solution:
    def singleNonDuplicate(self, nums: List[int]) -> int:
        if len(nums)==0:
            return 0

        if len(nums)==1:
            return nums[0]

        if nums[0]!=nums[1]:
            return nums[0]

        if nums[len(nums)-1] != nums[len(nums)-2]:
            return nums[len(nums)-1]

        l = 1
        h = len(nums)-2
        while l <= h:
            m = (l+h)//2
            if nums[m]!=nums[m-1] and nums[m]!=nums[m+1]:
                return nums[m]
            
            if (m%2 == 0 and nums[m+1] != nums[m]) or (m%2 !=0 and nums[m-1]!=nums[m]):
                h = m - 1
            else:
                l = m + 1

        return 0
