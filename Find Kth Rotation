class Solution:
    def findKRotation(self, nums):
        # code here
        
        INT_MAX = float('inf')
        ans = INT_MAX
        ind  = 0
    
        low = 0
        high = len(nums)-1
        while low<=high:
            mid = (low+high)//2
            if nums[low]<=nums[mid]:
                if nums[low]<ans:
                    ans = nums[low]
                    ind = low
                low = mid + 1
            else:
                if nums[mid]<ans:
                    ans = nums[mid]
                    ind = mid
                high = mid - 1

        return ind
